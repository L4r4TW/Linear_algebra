    "classificationCases":  [
                                {
                                    "name":  "missing classification",
                                    "lines":  [
                                                  "## DESCRIPTION",
                                                  "## ENDDESCRIPTION"
                                              ],
                                    "expected":  "missing"
                                },
                                {
                                    "name":  "partial hierarchy",
                                    "lines":  [
                                                  "## DBsubject(Geometry)",
                                                  "## DBchapter(Vector geometry)"
                                              ],
                                    "expected":  "partial"
                                },
                                {
                                    "name":  "empty section",
                                    "lines":  [
                                                  "## DBsubject(Geometry)",
                                                  "## DBchapter(Vector geometry)",
                                                  "## DBsection()"
                                              ],
                                    "expected":  "partial"
                                },
                                {
                                    "name":  "conflicting repeated subject",
                                    "lines":  [
                                                  "## DBsubject(Geometry)",
                                                  "## DBsubject(Linear algebra)",
                                                  "## DBchapter(Vector geometry)",
                                                  "## DBsection(Dot product, length, and unit vectors)"
                                              ],
                                    "expected":  "conflicting"
                                },
                                {
                                    "name":  "case variant values stay unmatched",
                                    "lines":  [
                                                  "## DBsubject(GEOMETRY)",
                                                  "## DBchapter(Vector geometry)",
                                                  "## DBsection(Dot product, length, and unit vectors)"
                                              ],
                                    "expected":  "unmapped"
                                },
                                {
                                    "name":  "unknown subject stays unmatched",
                                    "lines":  [
                                                  "## DBsubject(ZZZ-Inserted Text)",
                                                  "## DBchapter(ZZZ-Inserted Text)",
                                                  "## DBsection(ZZZ-Inserted Text)"
                                              ],
                                    "expected":  "unmapped"
                                },
                                {
                                    "name":  "exact full tuple with outer quotes",
                                    "lines":  [
                                                  "## DBsubject(\u0027Geometry\u0027)",
                                                  "## DBchapter(Vector geometry)",
                                                  "## DBsection(Dot product, length, and unit vectors)"
                                              ],
                                    "expected":  "matched"
                                },
                                {
                                    "name":  "malformed declaration requires diagnostics",
                                    "lines":  [
                                                  "## DBsubject(Geometry",
                                                  "## DBchapter(Vector geometry)",
                                                  "## DBsection(Dot product, length, and unit vectors)"
                                              ],
                                    "expected":  "malformed"
                                },
                                {
                                    "name":  "child label under wrong ancestor",
                                    "lines":  [
                                                  "## DBsubject(Statistics)",
                                                  "## DBchapter(Vector geometry)",
                                                  "## DBsection(Dot product, length, and unit vectors)"
                                              ],
                                    "expected":  "unmapped"
                                }
                            ]
